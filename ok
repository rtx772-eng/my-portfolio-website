// Outil de diagnostic local
function runDiag(){
  const out = document.getElementById('diagOut');
  let html = '<div class="diag">';
  html += `<div class="drow"><span>LocalStorage Site</span><b class="ok">ACTIF</b><em>${localStorage.getItem('0xredlog_site') ? 'Données présentes' : 'Vide'}</em></div>`;
  html += `<div class="drow"><span>LocalStorage Posts</span><b class="ok">ACTIF</b><em>${postsData.length} articles enregistrés</em></div>`;
  html += `<div class="drow"><span>Mode d'administration</span><b class="ok">SÉCURISÉ</b><em>Authentification locale active</em></div>`;
  html += '</div>';
  out.innerHTML = html;
  showToast('Diagnostic exécuté');
}

// Gestion des visiteurs et compteurs
function clearVisitors(){
  showToast('Journal des visiteurs nettoyé');
}

function resetCounters(){
  if(confirm('Réinitialiser tous les compteurs ?')) {
    showToast('Compteurs réinitialisés');
  }
}

// Utilitaire pour basculer l'affichage des panneaux d'administration
function togglePanel(id, forceOpen=false){
  const el = document.getElementById(id);
  if(!el) return;
  if(forceOpen) el.style.display = 'block';
  else el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
