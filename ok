// --- FONCTIONNALITÉS COMPLÈTES DE GESTION ET PUBLICATION ---

let importedFileContent = "";
let importedImages = [];
let customHtmlContent = "";

// Gestion des icônes d'articles
function uploadPostIcon(input){
  if(input.files && input.files[0]){
    const r = new FileReader();
    r.onload = e => {
      document.getElementById('eIconPrev').innerHTML = `<img class="prevshot sm" src="${e.target.result}" alt="Icon">`;
      showToast('Icône chargée');
    };
    r.readAsDataURL(input.files[0]);
  }
}

// Insertion de captures d'écran dans l'éditeur Markdown
function insertImages(input){
  if(input.files && input.files.length){
    Array.from(input.files).forEach(file => {
      const r = new FileReader();
      r.onload = e => {
        const markdownImg = `\n![Capture](${e.target.result})\n`;
        const bodyArea = document.getElementById('eBody');
        bodyArea.value += markdownImg;
        showToast('Image insérée dans le markdown');
      };
      r.readAsDataURL(file);
    });
  }
}

// Lecture des fichiers Markdown ou HTML importés
function readImportFile(file){
  if(!file) return;
  document.getElementById('impFileName').innerText = file.name;
  const r = new FileReader();
  r.onload = e => {
    importedFileContent = e.target.result;
    // Pré-remplir le titre si vide
    const titleInput = document.getElementById('impTitle');
    if(!titleInput.value) {
      titleInput.value = file.name.replace(/\.[^/.]+$/, "").replace(/-/g, " ");
    }
    showToast('Fichier importé avec succès');
  };
  r.readAsText(file);
}

function loadImportImages(input){
  if(input.files){
    importedImages = Array.from(input.files);
    document.getElementById('impImgList').innerText = `${importedImages.length} image(s) sélectionnée(s)`;
  }
}

// Exécuter l'importation d'un article Markdown
function runImport(){
  const title = document.getElementById('impTitle').value.trim();
  if(!title){ showToast('Veuillez entrer un titre', true); return; }
  if(!importedFileContent){ showToast('Veuillez sélectionner un fichier source', true); return; }

  const id = 'p_' + Date.now();
  const cat = document.getElementById('impCat').value || 'Red Teaming';
  const tags = document.getElementById('impTags').value.split(',').map(s=>s.trim()).filter(Boolean);
  const date = new Date().toISOString().slice(0,10);
  const excerpt = title;

  const postObj = {id, title, cat, date, rt:'6 min', draft:false, excerpt, tags, icon:''};
  postsData.unshift(postObj);
  postContentData[id] = importedFileContent;

  localStorage.setItem('0xredlog_posts', JSON.stringify(postsData));
  localStorage.setItem('0xredlog_content', JSON.stringify(postContentData));
  
  document.getElementById('impMsg').className = 'msg show ok';
  document.getElementById('impMsg').innerText = 'Article importé et publié avec succès !';
  renderAdminPosts();
  applySiteData();
  setTimeout(() => { togglePanel('impMd'); document.getElementById('impMsg').className = 'msg'; }, 2000);
}

